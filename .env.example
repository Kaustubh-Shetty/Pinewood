# Copy this file to ".env" and fill in the values.
# See SETUP.md for the full click-by-click walkthrough — no card required anywhere below.

# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Run `npx web-push generate-vapid-keys` locally, paste the "Public Key" here.
# The Private Key goes into the Edge Function secrets instead (see SETUP.md) —
# never put it in this file or in any frontend code.
VITE_VAPID_PUBLIC_KEY=

# Fixed number of flats this building has (display only — the real cap is
# how many rows exist in phone_to_flat / households, set by the seed script).
VITE_MAX_HOUSEHOLDS=13
